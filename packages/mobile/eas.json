{
  "cli": {
    "version": ">= 18.0.5",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview"
    },
    "production": {
      "distribution": "store",
      "autoIncrement": true,
      "channel": "production"
    },
    "e2e-simulator": {
      "extends": "preview",
      "withoutCredentials": true,
      "ios": {
        "simulator": true
      }
    },
    "beta": {
      "extends": "production",
      "channel": "beta"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "REPLACE_WITH_YOUR_ASC_APP_ID"
      },
      "android": {
        "track": "internal"
      }
    }
  }
}
