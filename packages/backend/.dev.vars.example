# Database Provider (sqlite or d1)
DB_PROVIDER=sqlite

# Database Encryption (required when ENCRYPT_NOTES=true)
# Generate: openssl rand -base64 32
DB_ENCRYPTION_KEY=your-32-byte-base64-encoded-secret

# Notes Encryption (enabled by default — set to true to disable)
DISABLE_NOTE_ENCRYPTION=false

# Google OAuth (optional - for Contacts integration)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8787/api/integrations/google/callback

# External APIs (optional)
APOLLO_API_KEY=your-apollo-api-key
CLEARBIT_API_KEY=your-clearbit-api-key

# Meilisearch (optional — enables fuzzy contact search for mobile clients)
# The document namespace ("instance hash") is derived from DB_ENCRYPTION_KEY +
# MEILISEARCH_API_KEY_UID at runtime, so there is no INSTANCE_HASH var to set.
# MEILISEARCH_URL=http://localhost:7700
# MEILISEARCH_API_KEY=your-meilisearch-api-key-value
# MEILISEARCH_API_KEY_UID=your-meilisearch-api-key-uid

# S3/R2 Storage (Cloudflare R2 — for contact avatars and other assets)
# Create R2 API credentials: Cloudflare Dashboard → R2 → Manage R2 API Tokens
S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_BUCKET_NAME=orbital-assets
S3_REGION=auto
S3_ACCESS_KEY_ID=your-r2-access-key-id
S3_SECRET_ACCESS_KEY=your-r2-secret-access-key
S3_PUBLIC_URL_PREFIX=https://pub-<bucket_id>.r2.dev
