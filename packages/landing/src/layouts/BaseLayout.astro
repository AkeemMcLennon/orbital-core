---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const DEFAULT_DESCRIPTION =
  'A personal relationship manager for people who meet a lot of people. Add someone from a link, screenshot, or contact card, and quick quizzes make names and faces stick. In beta on iOS and Android.';

const { title, description = DEFAULT_DESCRIPTION } = Astro.props;

// The 'file' build format makes pathname '/privacy.html' during SSG, but every
// link on the site (and the URL Cloudflare serves) is extensionless.
const path =
  Astro.url.pathname.replace(/index\.html$/, '').replace(/\.html$/, '') || '/';
const canonical = new URL(path, Astro.site).href;
const ogImage = new URL('/og.png', Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#331875" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Orbital" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1024" />
    <meta property="og:image:height" content="500" />
    <meta property="og:image:alt" content="Orbital — your personal relationship manager" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Orbital — your personal relationship manager" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <main>
      <slot />
    </main>
    <slot name="footer" />
  </body>
</html>
