---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import FeatureSection from '../components/FeatureSection.astro';
import SourceCards from '../components/SourceCards.astro';
import CtaBand from '../components/CtaBand.astro';
import Footer from '../components/Footer.astro';

import addContactScreen from '../assets/screens/add-contact.png';
import contactDetailScreen from '../assets/screens/contact-detail.png';
---

<BaseLayout title="Orbital — Your personal relationship manager">
  <Hero />

  <FeatureSection
    heading="No typing required."
    body="Share a profile and Orbital fills in the details."
    image={addContactScreen}
    alt="The Orbital add-contact screen, pre-filled from a shared Instagram profile"
    tinted
  >
    <SourceCards />
    <p class="note">
      You can also scan a business card or import from your phone and Google
      Contacts.
    </p>
  </FeatureSection>

  <FeatureSection
    heading="Where you met, what they care about, who they know."
    body="Jot things down while they're still fresh. Notes, tags, social links, and how your people connect all live on the contact card. All of it searchable."
    image={contactDetailScreen}
    alt="An Orbital contact detail screen showing tags, notes, and relationships for a contact"
    reverse
  />

  <CtaBand />
  <Footer slot="footer" />
</BaseLayout>
