---
interface Props {
  variant?: 'light' | 'dark';
  align?: 'start' | 'center';
}

const { variant = 'light', align = 'start' } = Astro.props;

const TESTFLIGHT_URL = 'https://testflight.apple.com/join/yHDqnJPY';
const PLAY_URL = 'https://play.google.com/store/apps/details?id=diy.orbital.mobile';
---

<style>
  .store-buttons {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .store-buttons.center {
    justify-content: center;
  }

  .store-btn {
    background: var(--primary);
    color: var(--white);
    padding: 0.625rem 1.5rem;
    border-radius: 0.75rem;
    display: flex;
    align-items: center;
    text-decoration: none;
    border: none;
    min-width: 195px;
    justify-content: center;
    gap: 0.625rem;
  }

  .dark .store-btn {
    background: var(--white);
    color: var(--primary);
  }

  @media (prefers-reduced-motion: no-preference) {
    .store-btn {
      transition:
        transform 0.2s,
        box-shadow 0.2s;
    }

    .store-btn:hover {
      transform: translateY(-2px);
    }
  }

  .store-btn:hover {
    box-shadow: 0 8px 16px rgba(var(--primary-rgb), 0.25);
  }

  .dark .store-btn:hover {
    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.25);
  }

  .store-btn-text {
    display: flex;
    flex-direction: column;
    text-align: left;
    line-height: 1.2;
  }

  .store-btn-label {
    font-size: 0.6875rem;
    font-weight: 400;
    opacity: 0.85;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .store-btn-name {
    font-size: 1rem;
    font-weight: 600;
  }

  @media (max-width: 600px) {
    .store-buttons {
      flex-direction: column;
      align-items: stretch;
    }
    .store-buttons.center {
      align-items: center;
    }
    .store-btn {
      width: 100%;
      max-width: 260px;
    }
  }
</style>

<div class:list={['store-buttons', variant === 'dark' && 'dark', align === 'center' && 'center']}>
  <a href={TESTFLIGHT_URL} class="store-btn" target="_blank" rel="noopener">
    <svg width="20" height="20" viewBox="0 0 814 1000" fill="currentColor" aria-hidden="true">
      <path d="M788.1 340.9c-5.8 4.5-108.2 62.2-108.2 190.5 0 148.4 130.3 200.9 134.2 202.2-.6 3.2-20.7 71.9-68.7 141.9-42.8 61.6-87.5 123.1-155.5 123.1s-85.5-39.5-164-39.5c-76 0-103.7 40.8-165.9 40.8s-105-37.3-148.9-80.9C113.2 716.4 69 604 69 493.4c0-234.4 145.2-358.3 288.4-358.3 73.5 0 134.8 48.1 180.6 48.1 43.5 0 111.7-51 194.6-51 31.4 0 115.1 2.6 181.3 96.8zM546.5 115.5c34.9-41.5 59.6-99.3 59.6-157.1 0-8.1-.6-16.3-2-23.8-55.9 2.3-121.5 37.2-162.7 80.9-31.4 34.2-61 91.9-61 150.4 0 9 1.3 18 2 20.7 3.5.6 9 1.3 14.5 1.3 49.9 0 108.1-33.5 149.6-72.4z" />
    </svg>
    <div class="store-btn-text">
      <span class="store-btn-label">Join the beta on</span>
      <span class="store-btn-name">TestFlight</span>
    </div>
    <span class="sr-only">(opens in a new tab)</span>
  </a>
  <a href={PLAY_URL} class="store-btn" target="_blank" rel="noopener">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M3.18 23.76a2.1 2.1 0 0 1-1.04-1.86V2.1A2.1 2.1 0 0 1 3.18.24L13.8 12 3.18 23.76z" opacity=".6" />
      <path d="M17.52 15.9l-3.42-1.97-2.22 2.14 4.1 4.1a2.1 2.1 0 0 0 1.54-3.27z" opacity=".8" />
      <path d="M17.52 8.1a2.1 2.1 0 0 0-1.54-3.27l-4.1 4.1 2.22 2.14L17.52 8.1z" opacity=".9" />
      <path d="M13.8 12 3.18.24a2.1 2.1 0 0 0-.82.55l11.22 11.21L13.8 12z" opacity=".4" />
    </svg>
    <div class="store-btn-text">
      <span class="store-btn-label">Get it on</span>
      <span class="store-btn-name">Google Play</span>
    </div>
    <span class="sr-only">(opens in a new tab)</span>
  </a>
</div>
