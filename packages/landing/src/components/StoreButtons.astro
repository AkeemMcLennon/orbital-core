---
interface Props {
  variant?: 'light' | 'dark';
  align?: 'start' | 'center';
}

const { variant = 'light', align = 'start' } = Astro.props;

// iOS is TestFlight-only for now. Apple's "Download on the App Store" badge may
// only link to a live App Store listing, and Apple publishes no TestFlight badge
// of its own, so the iOS CTA uses the community "Available on TestFlight" badge
// (https://askyourself.app/assets/testflight.png). When the app ships publicly,
// swap it for Apple's official black App Store badge, placed first:
// https://toolbox.marketingtools.apple.com/app-store/
const TESTFLIGHT_URL = 'https://testflight.apple.com/join/yHDqnJPY';
const PLAY_URL = 'https://play.google.com/store/apps/details?id=diy.orbital.mobile';
---

<style>
  .store-buttons {
    /* Google's badge artwork is 646x250 with the required clear space baked in
       as transparent margin: the visible badge is 564x168, inset 41px on every
       side. Scale the untouched file so the visible badge is --cta-height tall,
       then pull that transparent inset back out of the layout so both badges
       line up. The 1rem flex gap keeps the clear space. */
    --cta-height: 3.25rem;
    --badge-file-height: calc(var(--cta-height) * 250 / 168);
    --badge-inset: calc(var(--cta-height) * -41 / 168);

    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .store-buttons.center {
    justify-content: center;
  }

  /* Neither badge takes a hover, shadow or animation: Google's guidelines don't
     allow its artwork to be altered or animated, and the pair should match. */
  .badge-link {
    display: flex;
    align-items: center;
    text-decoration: none;
  }

  .play-badge {
    height: var(--badge-file-height);
    width: auto;
    margin: var(--badge-inset);
  }

  .testflight-badge {
    height: var(--cta-height);
    width: auto;
    box-sizing: border-box;
    /* The community badge ships edge-to-edge with no keyline; add the same thin
       border the Play badge has so the two read as a pair and the black artwork
       keeps an edge on the dark CTA band. Radius matches the artwork's own
       (24px on a 150px-tall file). */
    border: 1px solid #a6a6a6;
    border-radius: calc(var(--cta-height) * 24 / 150);
  }

  @media (max-width: 600px) {
    .store-buttons {
      flex-direction: column;
      align-items: flex-start;
    }
    .store-buttons.center {
      align-items: center;
    }
  }
</style>

<div class:list={['store-buttons', variant === 'dark' && 'dark', align === 'center' && 'center']}>
  <a href={TESTFLIGHT_URL} class="badge-link" target="_blank" rel="noopener">
    <img
      src="/badges/testflight-badge.png"
      alt="Available on TestFlight"
      width="440"
      height="150"
      class="testflight-badge"
    />
    <span class="sr-only">(opens in a new tab)</span>
  </a>
  <a href={PLAY_URL} class="badge-link" target="_blank" rel="noopener">
    <img
      src="/badges/google-play-badge.png"
      alt="Get it on Google Play"
      width="646"
      height="250"
      class="play-badge"
    />
    <span class="sr-only">(opens in a new tab)</span>
  </a>
</div>
