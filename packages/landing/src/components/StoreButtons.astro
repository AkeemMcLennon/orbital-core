    min-width: 175px;
    justify-content: center;
    transition: all 0.2s;
    gap: 0.625rem;
  }

  .store-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 16px rgba(51, 24, 117, 0.25);
  }

  .store-btn-text {
    display: flex;
    flex-direction: column;
    text-align: left;
    line-height: 1.2;
  }

  .store-btn-label {
    font-size: 0.575rem;
    font-weight: 400;
    opacity: 0.85;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .store-btn-name {
    font-size: 1rem;
    font-weight: 600;
  }

  @media (max-width: 600px) {
    .store-buttons {
      flex-direction: column;
    }
    .store-btn {
      width: 100%;
      max-width: 220px;
    }
  }
</style>

